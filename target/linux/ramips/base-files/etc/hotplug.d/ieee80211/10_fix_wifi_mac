#!/bin/sh

[ "$ACTION" = "add" ] || exit 0

PHYNBR=${DEVPATH##*/phy}
[ -n "$PHYNBR" ] || exit 0

. /lib/ramips.sh
. /lib/functions/system.sh

case "$(ramips_board_name)" in
raisecom-msg1500-x-00)
	[ "$PHYNBR" = "0" ] && \
		macaddr_setbit_la "$(mtd_get_mac_ascii Config protest_lan_mac)" \
			> "/sys${DEVPATH}/macaddress"
	;;
esac
